# Copy to .env.local and fill in values. Never commit real secrets.
NODE_ENV=development
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# App database used by Auth.js and application models.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ai_analytics_saas

# Auth.js providers: configure Google OAuth and/or SMTP email magic links.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=

# Generate a base64-encoded 32-byte key: openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=

# Required in production to allow customer database egress.
# Comma-separated exact hostnames or narrowly scoped wildcard suffixes, e.g. *.example.mongodb.net
OUTBOUND_DB_ALLOWED_HOSTS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADMIN_EMAILS=

# Stripe recurring prices and webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
